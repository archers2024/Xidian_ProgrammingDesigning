[Unit]
Description=Campus collaboration platform
After=network-online.target mysql.service
Wants=network-online.target
[Service]
Type=simple
User=activity
Group=activity
WorkingDirectory=/opt/activity-system/state
EnvironmentFile=/etc/activity-system/runtime.env
ExecStart=/usr/bin/java -Xms128m -Xmx512m -XX:+UseG1GC -Djava.awt.headless=true -Duser.timezone=Asia/Shanghai -jar /opt/activity-system/current/app/activity-system-1.0.0.jar --spring.config.additional-location=file:/opt/activity-system/current/deploy/application-prod.yml
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/activity-system/state
UMask=0077
StandardOutput=journal
StandardError=journal
[Install]
WantedBy=multi-user.target
