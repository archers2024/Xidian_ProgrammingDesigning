# Install through install.sh; keep the real runtime.env root-owned and mode 600.
CAMPUS_DB_USER=activity_runtime
CAMPUS_DB_PASSWORD=REPLACE_WITH_RANDOM_24_OR_MORE_CHARACTERS
CAMPUS_DB_URL=jdbc:mysql://127.0.0.1:3306/campus_activity?characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
CAMPUS_JWT_SECRET=REPLACE_WITH_SEPARATE_RANDOM_32_OR_MORE_CHARACTERS
CAMPUS_BOOTSTRAP_PASSWORD=REPLACE_WITH_ONE_TIME_INITIAL_PASSWORD
CAMPUS_PUBLIC_ORIGIN=https://campus.example.edu
# Optional trusted identity gateway. Never reuse the administrator JWT signing key.
CAMPUS_IDENTITY_SECRET=
CAMPUS_IDENTITY_ISSUER=
CAMPUS_IDENTITY_AUTHORIZE_URL=
# Optional private HTTPS object gateway; defaults to local storage.
CAMPUS_FILE_STORAGE=local
CAMPUS_FILE_OBJECT_ENDPOINT=
CAMPUS_FILE_OBJECT_TOKEN=
